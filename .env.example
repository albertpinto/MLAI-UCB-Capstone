# Copy to .env and fill in. This file is the only configuration; see src/capstone/config.py.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

QDRANT_URL=http://localhost:6335
COLLECTION=constitution_india

# Hugging Face id or a local path to a fine-tuned model. A new model with a different vector size needs a new COLLECTION.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# "" = auto; set to cpu to keep the GPU free
EMBED_DEVICE=
# CPU threads for embedding (keep well below your core count)
EMBED_THREADS=4

# Folder used by "Ingest docs folder" and the eval script
DOCS_DIR=data/docs
# LLM results per chunk are cached here, so a crashed ingest resumes instead of paying again
ENRICH_CACHE=data/enrichment_cache.jsonl
# JSON list of {"topic", "question"} shown as a pick list on the Ask page
SUGGESTED_QUESTIONS_FILE=data/suggested_questions.json

# Branding shown in the UI header
COMPANY_NAME=Bakasura
COMPANY_TAGLINE=Ask your documents anything
# A URL, or a file placed in frontend/public (e.g. /logo.png). Empty = show the first letter of the name.
LOGO_URL=/logo.svg
EVAL_QUESTIONS_FILE=eval/questions.json
EVAL_RESULTS_FILE=eval/results.json
FINE_TUNED_MODEL=
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_SEARCH=true
RERANK_CANDIDATES=30

# Knowledge graph: saved as <GRAPH_DIR>/<COLLECTION>.json, rebuilt after every ingest or delete
GRAPH_DIR=data/graphs
# Optional JSON {"alias": "canonical entity"} to merge names the normaliser cannot, e.g. {"SC": "Supreme Court"}
# GRAPH_ALIASES_FILE=data/aliases.json
# true: Ask/search also use passages tied to the question's entities in the graph. Measured: neutral on this corpus, so off.
GRAPH_SEARCH=false

# Documents: a document stored from now on expires after this many days and is flushed every FLUSH_INTERVAL_HOURS. 0 = never.
# Storing changed text under the same title replaces the document with version + 1.
DOCUMENT_TTL_DAYS=0
FLUSH_INTERVAL_HOURS=24

# Run Qdrant inside the API, keeping the index in this folder: no Docker needed (QDRANT_URL is then ignored).
# Copy an existing index into it once with: uv run python -m capstone.export_index data/qdrant
# QDRANT_PATH=data/qdrant

# Quality checks: off-topic questions the system should refuse, and where results and your reviews are kept
EVAL_UNANSWERABLE_FILE=eval/unanswerable.json
QUALITY_FILE=data/quality.json
